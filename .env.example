# The frontend uses Vite's same-origin /api (and /health, /ready) proxy in development.
# Target must be the companion apps/agent BFF on :8000 — not thin backend/.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

APP_ENV=development

# Required to encrypt Settings secrets in apps/agent (SecretService / Fernet).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_MASTER_KEY=

# Optional: match apps/agent default when using Docker Compose Postgres on host 5433.
# DATABASE_URL=postgresql://liara:liara@localhost:5433/liara_companion
#
# Pytest NEVER uses DATABASE_URL. It defaults to a separate DB and will refuse
# liara_companion. Override only if needed:
# TEST_DATABASE_URL=postgresql://liara:liara@localhost:5433/liara_companion_test

# Optional CORS origin when the browser talks to :8000 directly (Vite proxy is usual).
# Product UI is :5173; legacy Next was :3000.
# WEB_ORIGIN=http://localhost:5173

# Optional defaults — day-to-day Liara/Aval credentials live in the Settings UI, not here.
# Never commit real tokens or API keys.
# LIARA_API_BASE_URL=https://api.liara.ir
# LIARA_ALLOW_LIVE_WRITES=0
# Aval (Settings UI defaults): base https://api.avalai.ir/v1 ; model is user-configurable.
# LLM_BASE_URL=https://api.avalai.ir/v1
# LLM_MODEL=deepseek-v4.1-flash
